set terminal pngcairo size 1200,600 enhanced font 'Arial,12'
set output "AODV-energy_consumption-Scenario_4.png"
set title "AODV - Energy Consumption per Node (Scenario 4: Blackhole Attack + RREQ Flood)"

set title font 'Arial,16'
set xlabel 'Time (s)' font 'Arial,14'
set ylabel 'Consumed Energy (J)' font 'Arial,14'
set grid
set tics font 'Arial,12'
set key font 'Arial,12' outside right top
