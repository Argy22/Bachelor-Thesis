set terminal pngcairo size 1200,600 enhanced font 'Arial,12'
set output "AODV-energy_consumption-Scenario_3.png"
set title "AODV - Energy Consumption per Node (Scenario 3: Blackhole Attack + RERR)"

set title font 'Arial,16'
set xlabel 'Time (s)' font 'Arial,14'
set ylabel 'Consumed Energy (J)' font 'Arial,14'
set grid
set tics font 'Arial,12'
set key font 'Arial,12' outside right top
plot "-"  title "Node 1 (Blackhole)" with lines lc rgb '#ff0500' lw 2, "-"  title "Node 2 (Client)" with lines lc rgb '#3ebb4f' lw 2, "-"  title "Node 5 (Intermediate)" with lines lc rgb '#0081fa' lw 2
