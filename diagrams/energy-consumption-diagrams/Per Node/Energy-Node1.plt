set terminal pngcairo size 1200,600 enhanced font 'Arial,12'
set output "AODV-energy_consumption-node1.png"

set title "AODV - Energy Consumption for Node 1" font "Arial,16"
set xlabel "Time (s)" font "Arial,14"
set ylabel "Consumed Energy (J)" font "Arial,14"
set xrange[0:150] 
set yrange[0:13]


set grid
set key outside right top
plot "-"  title "Scenario 1" with lines lc rgb '#3ebb4f' lw 2, "-"  title "Scenario 2" with lines lc rgb '#ff0500' lw 2, "-"  title "Scenario 3" with lines lc rgb '#0081fa' lw 2, "-"  title "Scenario 4" with lines lc rgb '#c508f5' lw 2

